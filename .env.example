# Copy this file to .env and fill in your values.
# SECRET_KEY is used to encrypt SSH passwords stored in the database.
# Generate a strong random string: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-char-string

# Optional: override the backup retention count (default: 10)
# BACKUP_RETENTION_COUNT=10
